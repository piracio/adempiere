<project name="adempiereLiberoCE" default="dist" basedir=".">
  <description>
        Building Libero CostEngine.jar

        Original author:
        Victor Perez
        http://www.e-evolution.com

        Maintained and extended by:
        Prolinux (EFACT Ltda.)
        hmiranda@prolinux.cl

        Enhancements:
        - Costing model improvements (negative inventory, adjustments, landed cost)
        - Test coverage for costing edge cases
        - Build system portability improvements
  </description>
  <!-- set global properties for this build -->

  <property name="test.src.dir"
            value="src/test/java"/>

  <property name="test.build.dir"
            value="build/test"/>

  <!-- Runtime requires an explicit database identity; no default allowlist. -->
  <property name="costtest.case" value="TEST03"/>

  <property file="build-local.properties"/> 
  
  <property file="build.properties"/>

  <property name="src" location="src"/>
  <!--property name="patchSrc" location="patch/base/src"/-->
  <!--property name="liberoPatchSrc" location="patch/libero/src"/-->
  <property name="build" location="build"/>
  <!--property name="buildPatch" location="buildPatch"/-->
  <property name="dist"  location="./dist"/>

  <path id="integration.test.classpath">
    <pathelement location="${build}"/>
    <pathelement location="${test.build.dir}"/>
    <pathelement location="${adempiere.trunk}/base/build"/>

    <fileset dir="${adempiere.home}/lib">
      <include name="*.jar"/>
    </fileset>
    <fileset dir="${adempiere.trunk}/tools/lib">
      <include name="*.jar"/>
    </fileset>
    <fileset dir="${adempiere.trunk}/tools/lib/junit">
      <include name="*.jar"/>
    </fileset>
    <fileset dir="${adempiere.trunk}/packages">
      <include name="*.jar"/>
    </fileset>
  </path>

  <path id="patch.class.path">
     <fileset dir="${adempiere.home}/lib">
        <include name="*.jar"/>
     </fileset>
    <fileset dir="${adempiere.trunk}/packages">
           <include name="*.jar"/>
    </fileset>
  </path>

  <path id="lib.class.path">
    <!--fileset dir="${dist}/lib">
               <include name="*.jar"/>
    </fileset-->
    <fileset dir="${adempiere.home}/lib">
    <include name="Adempiere.jar"/>
     </fileset>

     <fileset dir="${adempiere.trunk}/tools/lib">
       <include name="*.jar"/>
     </fileset>

     <fileset dir="${adempiere.trunk}/packages">
       <include name="*.jar"/>
     </fileset>
  </path>

  <target name="init" depends="clean">
    <echo message="Trunk location: ${adempiere.trunk}"/>
    <echo message="ADempiere home: ${adempiere.home}"/>
    <!-- Create the time stamp -->
    <tstamp/>
    <!-- Create the build directory structure used by compile -->
    <mkdir dir="${build}"/>
    <!--mkdir dir="${buildPatch}"/-->
  </target>

  <target name="compile"
      description="compile the source " >
    <javac debug="false" includeantruntime="false" srcdir="${src}" destdir="${build}">
      <exclude name="test/**"/>
      <classpath refid="lib.class.path"/>
    </javac>
  </target>

  <target name="dist"  depends="init, compile, clean"
        description="generate the distribution" >
    <!-- Create the distribution directory -->
    <mkdir dir="${dist}/lib"/>

    <!-- Put everything in ${build} into the MyProject-${DSTAMP}.jar file -->
    <jar jarfile="${dist}/lib/liberoCE.jar" basedir="${build}" />

    <!-- Create target Libero deployment -->
    <mkdir dir="${adempiere.home}/packages/liberoCE/lib"/>

    <!-- Transfer liberoWM.jar -->
    <copy file="${dist}/lib/liberoCE.jar" todir="${adempiere.home}/packages/liberoCE/lib" filtering="true" />
    <copy file="${dist}/lib/liberoCE.jar" todir="${adempiere.trunk}/packages/"/>

  </target>

  <target name="patchDist" depends="patchCompile"
          description="generate the distribution" >
      <!-- Create the distribution directory -->
      <mkdir dir="${dist}/lib"/>

      <!-- Put everything in ${build} into the MyProject-${DSTAMP}.jar file -->
      <jar jarfile="${dist}/lib/patches.jar" basedir="${buildPatch}"/>

      <!-- Create target Libero deployment -->
      <mkdir dir="${adempiere.home}/lib"/>

      <!-- Transfer patchs.jar -->
      <copy file="${dist}/lib/patches.jar" todir="${adempiere.home}/lib"/>

  </target>

  <target name="patchCompile" depends="init"
        description="compile the source " >

    <!--javac debug="false" srcdir="${patchSrc}:${src}" destdir="${buildPatch}"-->
  <javac debug="false" srcdir="${src}" destdir="${build}">
      <include name="**/org/adempiere/engine/CostComponent.java"/>
      <include name="**/org/adempiere/engine/CostEngineFactory.java"/>
      <include name="**/org/compiere/acct/*.java"/>
      <include name="**/org/compiere/model/*.java"/>
      <include name="**/org/compiere/process/*.java"/>
      <include name="**/org/eevolution/model/*.java"/>
      <include name="**/org/adempiere/engine/*.java"/>
      <classpath refid="patch.class.path"/>
    </javac>

    <!--javac debug="true" srcdir="${liberoPatchSrc}" destdir="${build}">
          <include name="**/org/eevolution/model/*.java"/>
          <classpath refid="patch.class.path"/>
    </javac-->

  </target>

  <target name="compile-negative-inventory-test"
      description="compile negative inventory costing test">
    <mkdir dir="${build}"/>
    <javac debug="false"
           includeantruntime="false"
           destdir="${build}">

      <src path="${src}"/>
      <src path="${adempiere.trunk}/base/src"/>
      <src path="${adempiere.trunk}/org.eevolution.manufacturing/src/main/java/base"/>
      <src path="${adempiere.trunk}/org.adempiere.test/src/test/java"/>

      <include name="test/java/org/adempiere/NegativeInventoryCostAdjustmentTest.java"/>
      <include name="test/java/org/adempiere/NegativeInventoryDatabaseIdentityTest.java"/>
      <include name="org/adempiere/engine/AverageInvoiceCostingMethod.java"/>
      <include name="org/adempiere/engine/AbstractCostingMethod.java"/>
      <include name="org/adempiere/engine/CostEngine.java"/>
      <include name="org/compiere/model/MCostDetail.java"/>
      <include name="org/compiere/acct/Doc_MatchInv.java"/>
      <include name="org/compiere/acct/Doc_InOut.java"/>
      <include name="org/compiere/acct/Doc_Invoice.java"/>
      <include name="org/compiere/model/MInOut.java"/>
      <include name="org/adempiere/exceptions/ZeroSalesCostException.java"/>
      <include name="org/eevolution/manufacturing/process/GenerateCostDetail.java"/>

      <compilerarg value="-implicit:class"/>

      <classpath refid="integration.test.classpath"/>

    </javac>

  </target>
  <target name="run-negative-inventory-test"
      depends="compile-negative-inventory-test"
      description="run negative inventory costing test scaffold">
    <fail unless="costtest.properties"
          message="Set -Dcosttest.properties to the properties file for the dedicated seed clone."/>
    <java classname="org.adempiere.NegativeInventoryCostAdjustmentTest"
        fork="true"
        failonerror="true">
      <sysproperty key="PropertyFile" value="${costtest.properties}"/>
      <syspropertyset>
        <propertyref prefix="adempiere.costtest.database."/>
      </syspropertyset>
      <arg value="${costtest.case}"/>
      <classpath refid="integration.test.classpath"/>
    </java>
  </target>

  <target name="test-negative-inventory-identity" depends="compile-negative-inventory-test"
          description="run database identity validation without starting ADempiere">
    <java classname="org.junit.platform.console.ConsoleLauncher" fork="true" failonerror="true">
      <classpath refid="integration.test.classpath"/>
      <arg value="--select-class=org.adempiere.NegativeInventoryDatabaseIdentityTest"/>
      <arg value="--details=summary"/>
    </java>
  </target>

  <target name="test-negative-inventory-integration" depends="compile-negative-inventory-test"
          description="run the rollback-verified costing regressions on an explicitly configured seed clone">
    <fail unless="costtest.properties"
          message="Set -Dcosttest.properties to the properties file for the dedicated seed clone."/>
    <java classname="org.junit.platform.console.ConsoleLauncher" fork="true" failonerror="true">
      <classpath refid="integration.test.classpath"/>
      <sysproperty key="PropertyFile" value="${costtest.properties}"/>
      <syspropertyset><propertyref prefix="adempiere.costtest.database."/></syspropertyset>
      <arg value="--select-class=org.adempiere.NegativeInventoryCostAdjustmentTest"/>
      <arg value="--details=summary"/>
    </java>
  </target>

  <target name="clean"
        description="clean up" >
    <!-- Delete the ${build} and ${dist} directory trees -->
    <delete dir="${build}"/>
    <!--delete dir="${buildPatch}"/-->
    <delete dir="${dist}"/>
  </target>
</project>
